    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local > src/lib/database.types.ts",
    "test:fixtures": "node scripts/test-fixtures.mjs",
    "test:e2e": "supabase db reset && (docker start supabase_edge_runtime_Web-ASTEME-PinPong >/dev/null 2>&1 || true) && node scripts/test-fixtures.mjs && python3 .claude/skills/webapp-testing/scripts/with_server.py --server \"npx vite --port 5173 --strictPort\" --port 5173 --timeout 60 -- node e2e/run.cjs"
  },
