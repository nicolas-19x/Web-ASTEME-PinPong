# Copia este archivo como .env.local y completa con los datos de tu proyecto Supabase.
# Solo la clave PUBLICABLE va al navegador. Nunca pongas aquí la clave secreta/service_role.
VITE_SUPABASE_URL=https://<tu-proyecto>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Desarrollo local: también puedes usar VITE_SUPABASE_URL=/supabase para que el
# servidor de Vite reenvíe las llamadas al stack local (útil para abrir la app
# desde el celular o una vista previa).
